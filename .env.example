# AI provider 配置模板：复制为 .env 后填入真实值，真实密钥不要提交。
AI_PROVIDER=local

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

VOLCENGINE_API_KEY=
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_MODEL=

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# 被测服务地址
API_BASE_URL=http://localhost:8000

# 登录态配置。AUTH_ENABLED=true 时执行用例前先登录。
AUTH_ENABLED=false
AUTH_LOGIN_URL=https://your-company.example.com/login
AUTH_ACCOUNT=your_account
AUTH_PASSWORD=your_password
AUTH_APP_ID=your_app_id
AUTH_USER_INFO_URL=
AUTH_TENANT_INDEX=0
AUTH_TIMEOUT=20
